{
  "name": "dsh-openagent",
  "version": "0.1.11",
  "description": "DeepSeek Harness 的 OpenAgent 连接与业务 Skills。",
  "type": "module",
  "main": "runtime/index.js",
  "exports": { ".": "./runtime/index.js", "./client": "./runtime/client.js", "./locale/*.json": "./locale/*.json" },
  "files": ["runtime/index.js", "runtime/login.mjs", "runtime/bridge.mjs", "runtime/browser-host.mjs", "runtime/browser-protocol.mjs", "runtime/onboarding-host.mjs", "runtime/onboarding-protocol.mjs", "runtime/post-install.mjs", "runtime/client.js", "runtime/cordis.patch.yml", "uninstall.py", "locale", "skills", "README.md", "INSTALL.md", "INSTALL.en.md"],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "dsh": {
    "bundle": { "patch": "./runtime/cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-api-remotes", "@deepseek-ai/dsh-client-ui-sidebar-right", "@deepseek-ai/dsh-api-session-controller", "@deepseek-ai/dsh-client-ui-workspace", "@deepseek-ai/dsh-client-ui-conversation", "@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-renderer"],
      "external": []
    }
  },
  "dependencies": { "mcp-remote": "0.1.38", "@modelcontextprotocol/sdk": "1.26.0" },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-mcp-client": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-skill-filesystem": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-tools": ">=0.2.1-rc.2 <0.3.0",
    "@deepseek-ai/dsh-typert-protocol": ">=0.2.1-rc.2 <0.3.0"
  },
  "devDependencies": {
    "react": "18.3.1",
    "@deepseek-ai/dsh-app-boot": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-modules": "0.2.1-rc.2",
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-mcp-client": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill": "0.2.1-rc.2",
    "@deepseek-ai/dsh-skill-filesystem": "0.2.1-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.1-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.1-rc.2",
    "@deepseek-ai/dsh-typert-registry": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-remote-access": "0.2.1-rc.2",
    "@deepseek-ai/dsh-api-gateway": "0.2.1-rc.2",
    "@deepseek-ai/dsh-client-connection": "0.2.1-rc.2"
  },
  "scripts": {
    "build": "node scripts/build_client.mjs",
    "check": "python3 -B -m unittest discover -s tests -p 'test_*.py' && node --test tests/test_*.mjs",
    "deploy": "python3 -B scripts/deploy.py",
    "deploy:push": "python3 -B scripts/deploy.py --push"
  }
}
